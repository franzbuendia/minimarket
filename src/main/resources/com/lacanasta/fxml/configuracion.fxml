<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.ConfigController">

    <Label text="Configuración de la empresa" styleClass="module-title"/>

    <GridPane hgap="10.0" vgap="12.0" styleClass="form-panel">
        <Label text="Nombre comercial:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombreComercial" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="280.0"/>
        <Label text="RUC:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtRuc" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Dirección:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDireccion" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Teléfono:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTelefono" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Mensaje de ticket:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtMensajeTicket" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button text="Guardar" onAction="#onGuardar" styleClass="primary-button"/>
    </HBox>

</VBox>
