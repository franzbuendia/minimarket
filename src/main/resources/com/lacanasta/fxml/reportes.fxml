<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="18.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.ReporteController">

    <HBox alignment="BOTTOM_LEFT" spacing="12.0">
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label text="RESUMEN COMERCIAL" styleClass="eyebrow"/>
            <Label text="Reportes" styleClass="page-title"/>
            <Label text="Una vista clara del rendimiento de tu minimarket." styleClass="page-description"/>
        </VBox>
        <Label fx:id="lblFecha" styleClass="result-count"/>
        <Button text="Exportar PDF" onAction="#onExportarPDF" styleClass="btn, btn-outline">
            <graphic>
                <FontIcon iconLiteral="fas-file-pdf" iconSize="13"/>
            </graphic>
        </Button>
    </HBox>

    <HBox spacing="14.0">
        <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="metric-icon, metric-icon-green">
                <FontIcon iconLiteral="fas-chart-line" iconSize="18" iconColor="#10b981"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label text="Ventas del día" styleClass="metric-label"/>
                <Label fx:id="lblVentasDia" text="S/ 0.00" styleClass="metric-value"/>
            </VBox>
        </HBox>
        <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="metric-icon, metric-icon-blue">
                <FontIcon iconLiteral="fas-receipt" iconSize="18" iconColor="#0284c7"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label text="Transacciones" styleClass="metric-label"/>
                <Label fx:id="lblTransacciones" text="0" styleClass="metric-value"/>
            </VBox>
        </HBox>
        <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="metric-icon, metric-icon-blue">
                <FontIcon iconLiteral="fas-boxes" iconSize="18" iconColor="#0284c7"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label text="Productos vendidos" styleClass="metric-label"/>
                <Label fx:id="lblProductosVendidos" text="0" styleClass="metric-value"/>
            </VBox>
        </HBox>
        <HBox styleClass="metric-card" HBox.hgrow="ALWAYS">
            <StackPane styleClass="metric-icon, metric-icon-amber">
                <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="18" iconColor="#d97706"/>
            </StackPane>
            <VBox spacing="2.0">
                <Label text="Stock bajo" styleClass="metric-label"/>
                <Label fx:id="lblStockBajo" text="0" styleClass="metric-value"/>
            </VBox>
        </HBox>
    </HBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header">
                <VBox spacing="2.0">
                    <Label text="Transacciones recientes" styleClass="card-title"/>
                    <Label text="Últimas ventas registradas" styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#onActualizar" styleClass="btn, btn-outline">
                    <graphic>
                        <FontIcon iconLiteral="bi-arrow-clockwise" iconSize="13"/>
                    </graphic>
                </Button>
            </HBox>

            <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colTicket" text="Ticket" prefWidth="100.0" minWidth="80.0" maxWidth="120.0"/>
                    <TableColumn fx:id="colHora" text="Hora" prefWidth="100.0" minWidth="80.0" maxWidth="120.0"/>
                    <TableColumn fx:id="colMedio" text="Medio" prefWidth="120.0" minWidth="80.0" maxWidth="140.0"/>
                    <TableColumn fx:id="colTotal" text="Total" prefWidth="120.0" minWidth="80.0" maxWidth="140.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0" minWidth="80.0" maxWidth="140.0"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" prefWidth="380.0" VBox.vgrow="ALWAYS">
            <HBox styleClass="card-header">
                <VBox spacing="2.0">
                    <Label text="Alerta de stock" styleClass="card-title"/>
                    <Label text="Productos con menos de 5 unidades" styleClass="card-subtitle"/>
                </VBox>
            </HBox>

            <TableView fx:id="tablaStockBajo" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNombreStock" text="Producto" prefWidth="240.0"/>
                    <TableColumn fx:id="colStockBajo" text="Stock" prefWidth="100.0" minWidth="80.0" maxWidth="120.0"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" style="-fx-padding: 12 0 0 0;">
                <Button text="Revisar inventario" onAction="#onRevisarInventario" styleClass="btn, btn-soft">
                    <graphic>
                        <FontIcon iconLiteral="bi-arrow-right" iconSize="13"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>

</VBox>
