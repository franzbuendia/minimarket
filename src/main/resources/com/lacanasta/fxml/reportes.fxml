<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.ReporteController">

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Reportes" styleClass="module-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Actualizar" onAction="#onActualizar"/>
        <Button text="Exportar PDF" onAction="#onExportarPDF" styleClass="primary-button"/>
    </HBox>

    <Label fx:id="lblTotalHoy" styleClass="total-label"/>

    <Label text="Ventas de hoy" styleClass="subtitle-label"/>

    <TableView fx:id="tablaVentas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdVenta" text="Id" prefWidth="70.0"/>
            <TableColumn fx:id="colFechaVenta" text="Fecha" prefWidth="180.0"/>
            <TableColumn fx:id="colTotalVenta" text="Total" prefWidth="110.0"/>
            <TableColumn fx:id="colMetodoVenta" text="Método" prefWidth="110.0"/>
        </columns>
    </TableView>

    <Label text="Productos con stock bajo (≤ 5)" styleClass="subtitle-label"/>

    <TableView fx:id="tablaStockBajo" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="colNombreStock" text="Producto" prefWidth="240.0"/>
            <TableColumn fx:id="colStockBajo" text="Stock" prefWidth="80.0"/>
        </columns>
    </TableView>

</VBox>
