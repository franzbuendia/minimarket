<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.ProveedorController">

    <Label text="Proveedores" styleClass="module-title"/>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180.0"/>
            <TableColumn fx:id="colContacto" text="Contacto" prefWidth="140.0"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="120.0"/>
            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="220.0"/>
        </columns>
    </TableView>

    <GridPane hgap="10.0" vgap="10.0">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="220.0"/>
        <Label text="Contacto:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtContacto" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Teléfono:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtTelefono" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label text="Dirección:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtDireccion" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button text="Nuevo" onAction="#onNuevo"/>
        <Button text="Guardar" onAction="#onGuardar" styleClass="primary-button"/>
        <Button text="Eliminar" onAction="#onEliminar" styleClass="danger-button"/>
    </HBox>

</VBox>
