<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="module"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lacanasta.controller.ProductoController">

    <Label text="Gestión de Productos" styleClass="module-title"/>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre..." prefWidth="240.0"/>
        <Button text="Buscar" onAction="#onBuscar"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Nuevo" onAction="#onNuevo" styleClass="primary-button"/>
        <Button text="Editar" onAction="#onEditar"/>
        <Button text="Activar / Desactivar" onAction="#onActivarDesactivar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="130.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220.0"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120.0"/>
            <TableColumn fx:id="colPrecioNormal" text="Precio Normal" prefWidth="110.0"/>
            <TableColumn fx:id="colPrecioDescuento" text="Precio Descuento" prefWidth="120.0"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="80.0"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0"/>
        </columns>
    </TableView>

</VBox>
